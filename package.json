{
  "name": "kataru",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "build:binary": "npm run build && cargo build --release",
    "check:release-version": "node scripts/check-release-version.mjs",
    "check:rust": "cargo test",
    "dummy:api": "node scripts/dummy-api-server.mjs",
    "test": "npm run test:unit && npm run test:migration && npm run test:branch",
    "test:unit": "vitest run",
    "test:migration": "node --experimental-strip-types --test tests/aiSettingsMigration.test.mjs",
    "test:branch": "node --experimental-strip-types --test tests/conversationBranch.test.mjs",
    "dev": "node --env-file=.env.local scripts/dev.mjs",
    "dev:server": "cargo run -- --dev-origin http://127.0.0.1:3000",
    "dev:ui": "vite",
    "start": "node scripts/start.mjs",
    "smoke:binary": "node scripts/smoke-binary.mjs",
    "lint": "eslint"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "clsx": "^2.1.1",
    "framer-motion": "^14.7.1",
    "lucide-react": "^1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4",
    "typescript": "^7",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.1.5",
    "vitest": "^5.0.5"
  }
}
